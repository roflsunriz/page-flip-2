{
    "name": "page-flip-2",
    "version": "0.2.3",
    "description": "Bun-first page-turning library with bidirectional reading support",
    "type": "module",
    "main": "./dist/page-flip-2.js",
    "module": "./dist/page-flip-2.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/page-flip-2.js",
            "default": "./dist/page-flip-2.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "author": "roflsunriz",
    "contributors": [
        "Oleg Litovski <oleg.litovski9@gmail.com>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/roflsunriz/page-flip-2.git"
    },
    "homepage": "https://github.com/roflsunriz/page-flip-2",
    "engines": {
        "bun": ">=1.3.14"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit && tsc --project tsconfig.test.json",
        "build": "bun scripts/build.mjs",
        "demo": "bun scripts/demo.mjs",
        "pack:release": "bun scripts/pack.mjs",
        "release:check": "bun run lint && bun run format:check && bun run type-check && bun test && bun audit && bun scripts/pack.mjs --dry-run",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "keywords": [
        "typescript",
        "page",
        "flip",
        "canvas",
        "book",
        "reader",
        "rtl",
        "ltr",
        "bun"
    ],
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.3.14",
        "eslint": "10.8.1",
        "global-jsdom": "29.0.0",
        "globals": "17.11.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "patchedDependencies": {
        "tr46@6.0.0": "patches/tr46@6.0.0.patch"
    }
}
