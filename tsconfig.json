{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": false,
        "noImplicitAny": true,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "skipLibCheck": true,
        "useDefineForClassFields": false,
        "noEmitOnError": true
    },
    "include": ["src/**/*.ts"]
}
